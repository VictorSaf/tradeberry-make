<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.victor.tradeberry-tickroll</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-c</string><string>TB_TICKS="$HOME/tradeberry/data/ticks.db" exec /opt/homebrew/bin/node "$HOME/tradeberry/code/host/tick-roll.mjs"</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/victorsafta/tradeberry/logs/tickroll.log</string>
  <key>StandardErrorPath</key><string>/Users/victorsafta/tradeberry/logs/tickroll.log</string>
</dict></plist>
